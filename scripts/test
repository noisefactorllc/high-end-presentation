#!/bin/sh
# Run the repository's test suite (see README "Development"). Reuses .venv
# when present; otherwise builds one. uv is used when available: it can
# bootstrap a venv on pythons that lack ensurepip, and it can provide a
# Python >= 3.12, which the pinned numpy (tests/requirements.txt) requires.
set -eu
cd "$(dirname "$0")/.."

if [ ! -x .venv/bin/python ]; then
    rm -rf .venv
    if command -v uv >/dev/null 2>&1; then
        uv venv --python '>=3.12' .venv
        uv pip install --python .venv/bin/python -r tests/requirements.txt
    else
        python3 -m venv .venv
        .venv/bin/python -m pip install -r tests/requirements.txt
    fi
fi
exec .venv/bin/python -m pytest tests -q "$@"
